// Pseudo C compiler based on initial version of Tiny Context compiler (http://avhohlov.narod.ru/p1805en.htm)
// To compile with gcc or bcc32 replace all functions from open() to halt() with #include "C.INC"
// and change main() function return type to int
//
// Modified and reformatted for compatibility with cc1k
//
// (C) Andrei V. Khokhlov

char  Text  [  1024 ] ;
word pText ;
word nText ;
word nLine ;

byte  Code  [ 49152 ] ;
word nCode ;

word hFile ;

char  Heap  [  2048 ] ;
word pHeap ;
word nHeap ;

word nData ;

word  Name  [   128 ] ;
word  Cls   [   128 ] ;
word  Type  [   128 ] ;
word  Size  [   128 ] ;
word  Ofs   [   128 ] ;
word pName ;
word nName ;

word  Stk   [    32 ] ;
word pStk ;

char  Buff  [   256 ] ;
word pBuff ;


word  open ( )
// mov  AH, 0x3D
  asm db       180 ,   61
// mov  AL, 0
  asm db       176 ,    0
// mov  DX, &Heap
  asm db       186
// dw       offset   Heap ;
  asm db        10,   196
// add  DX, 62
  asm db       131 ,  194 ,   62
// int  0x21
  asm db       205 ,   33
end


word  create ( )
// mov  AH, 0x3C
  asm db       180 ,   60
// mov  CX, 0
  asm db       185 ,    0 ,    0
// mov  DX, &Heap
  asm db       186
// dw       offset   Heap ;
  asm db        10,   196
// add  DX, 66
  asm db       131 ,  194 ,   66
// int  0x21
  asm db       205 ,   33
end


word  read ( )
// mov  AH, 0x3F
  asm db       180 ,   63
// mov  BX, hFile
  asm db       139 ,   30
// dw       offset   hFile ;
  asm db         8 ,  196
// mov  CX, 1024
  asm db       185 ,    0 ,    4
// mov  DX, &Text
  asm db       186
// dw       offset   Text ;
  asm  db        0,     0
// int  0x21
  asm db       205 ,   33
end


word  write ( )
// mov  AH, 0x40
  asm db       180 ,   64
// mov  BX, hFile
  asm db       139 ,   30
// dw       offset   hFile ;
  asm db         8 ,  196
// mov  CX, nCode
  asm db       139 ,   14
// dw       offset   nCode ;
  asm db         6 ,  196
// mov  DX, &Code
  asm db       186
// dw       offset   Code ;
  asm db         6 ,    4
// int  0x21
  asm db       205 ,   33
end


word  close ( )
// mov  AH, 0x3E
  asm db       180 ,   62
// mov  BX, hFile
  asm db       139 ,   30
// dw       offset   hFile ;
  asm db         8 ,  196
// int  0x21
  asm db       205 ,   33
end


// char      Ch;                          // INFO Space omitted!
// char      Chr ;
word         Chr ;

char      putchr ( )
// xchg DX, AX
  asm db       146
// mov  AH, 0x02
  asm db       180 ,    2
// int  0x21
  asm db       205 ,   33
end


word  halt ( )
// mov  AX, 0x4C00
  asm db       184 ,    0 ,   76
// int  0x21
  asm db       205 ,   33
end


word CharToWord ( char Ch )
  asm db      08AH, 086H, 004H, 000H
  asm db      032H, 0E4H
end


word ByteToWord ( byte B )
  asm db      08AH, 086H, 004H, 000H
  asm db      032H, 0E4H
end


word  Init ( )
  Heap [  0 ] = '0' ;
  Heap [  1 ] = '1' ;
  Heap [  2 ] = '2' ;
  Heap [  3 ] = '3' ;
  Heap [  4 ] = '4' ;
  Heap [  5 ] = '5' ;
  Heap [  6 ] = '6' ;
  Heap [  7 ] = '7' ;
  Heap [  8 ] = '8' ;
  Heap [  9 ] = '9' ;
  Heap [ 10 ] = 'A' ;
  Heap [ 11 ] = 'B' ;
  Heap [ 12 ] = 'C' ;
  Heap [ 13 ] = 'D' ;
  Heap [ 14 ] = 'E' ;
  Heap [ 15 ] = 'F' ;

  Heap [ 16 ] = 'c' ;
  Heap [ 17 ] = 'h' ;
  Heap [ 18 ] = 'a' ;
  Heap [ 19 ] = 'r' ;
  Heap [ 20 ] =  #0 ;

  Heap [ 21 ] = 'u' ;
  Heap [ 22 ] = 'n' ;
  Heap [ 23 ] = 's' ;
  Heap [ 24 ] = 'i' ;
  Heap [ 25 ] = 'g' ;
  Heap [ 26 ] = 'n' ;
  Heap [ 27 ] = 'e' ;
  Heap [ 28 ] = 'd' ;
  Heap [ 29 ] =  #0 ;

  Heap [ 30 ] = '{' ;
  Heap [ 31 ] =  #0 ;

  Heap [ 32 ] = 'i' ;
